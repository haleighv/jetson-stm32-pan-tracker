	(text "E-stop: NC switch on J8 holds ESTOP_SW low. Open switch or broken wire -> R4 pulls high -> Q1 pulls EN low -> VNH5019 off, firmware sees the fault."
		(exclude_from_sim no)
		(at 30.48 271.78 0)
